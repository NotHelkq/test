<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hiddify_bg_dark"
    android:orientation="vertical"
    tools:context=".ui.TrafficFragment">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/traffic_tab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hiddify_bg_dark"
        app:elevation="0dp"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorColor="@color/hiddify_primary_cyan"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabPaddingStart="16dp"
        app:tabRippleColor="@color/hiddify_glow_cyan"
        app:tabSelectedTextColor="@color/hiddify_primary_cyan"
        app:tabTextAppearance="@style/TabTextAppearance"
        app:tabTextColor="@color/hiddify_text_secondary"
        app:tabUnboundedRipple="false" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/traffic_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hiddify_bg_dark" />

</LinearLayout>